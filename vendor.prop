#
# Vendor props for the DuoQin Qin F25 Pro (curated from stock
# vendor build.prop - see proprietary-refs/vendor-build.prop.stock)
#

# Graphics: Mali-G52 via MTK's "meow" EGL wrapper
ro.hardware.egl=meow
ro.hardware.hwcomposer=mtk_common
ro.opengles.version=196610

# Platform
ro.vendor.mediatek.platform=MT6768
ro.vendor.mediatek.version.branch=alps-mp-s0.mp1

# Consumer IR
ro.hardware.consumerir=common

# Keypad
ro.vendor.keypad_mode=normal
