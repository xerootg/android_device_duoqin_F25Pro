<?xml version="1.0" encoding="UTF-8"?>
<!--
    Local manifest for building DumberOS/LineageOS for the Qin F25 Pro.

    Usage:
      repo init -u https://github.com/miki151/dumberos_manifests.git (with git-lfs)
      mkdir -p .repo/local_manifests
      cp device/duoqin/F25Pro/local_manifests/duoqin_F25Pro.xml .repo/local_manifests/
      repo sync -c

    remove-project names must match the project name attributes in
    dumberos_manifests/default.xml; re-verify after any upstream manifest
    change. (No double hyphens in this comment: illegal in XML.)
-->
<manifest>
  <remote name="xerootg" fetch="https://github.com/xerootg/" />

  <!-- Device, vendor, kernel -->
  <project path="device/duoqin/F25Pro" name="android_device_duoqin_F25Pro" remote="xerootg" revision="main" />
  <project path="vendor/duoqin/F25Pro" name="android_vendor_duoqin_F25Pro" remote="xerootg" revision="main" />
  <project path="kernel/duoqin/F25Pro" name="android_kernel_duoqin_F25Pro" remote="xerootg" revision="lineage-21-f25pro" />

  <!-- lineage-21 frameworks/base hard-depends on the Samsung radio HAL
       java interfaces; the DumberOS manifest ships only hardware/samsung/nfc -->
  <project path="hardware/samsung" name="LineageOS/android_hardware_samsung" remote="github" revision="refs/heads/lineage-21.0" />

  <!-- Drop GSI-only projects from the DumberOS manifest: this is a real
       per-device build, not a Treble GSI. -->
  <remove-project name="DumberOS/device_phh_treble" />
  <remove-project name="miki151/treble_app" />
  <remove-project name="phhusson/vendor_vndk-tests" />
  <remove-project name="TrebleDroid/vendor_interfaces" />
  <remove-project name="AndyCGYan/android_packages_apps_QcRilAm" />
</manifest>
